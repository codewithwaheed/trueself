generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  createdAt   DateTime           @default(now())
  users       User[]
  sessions    InterviewSession[]
  invitations Invitation[]
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  name               String
  passwordHash       String?
  role               Role               @default(INTERVIEWER)
  companyId          String
  company            Company            @relation(fields: [companyId], references: [id])
  sessions           InterviewSession[]
  sessionInvitees    SessionInvitee[]
  emailVerified      Boolean            @default(false)
  onboardingComplete Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

enum Role {
  ADMIN
  INTERVIEWER
}

model Invitation {
  id        String           @id @default(cuid())
  email     String
  name      String           @default("")
  token     String           @unique
  companyId String
  company   Company          @relation(fields: [companyId], references: [id])
  role      Role             @default(INTERVIEWER)
  invitedBy String
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime         @default(now())

  @@index([email])
  @@index([token])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model InterviewSession {
  id                     String        @id @default(cuid())
  sessionCode            String        @unique // 6-digit code
  companyId              String
  company                Company       @relation(fields: [companyId], references: [id])
  interviewerId          String
  interviewer            User          @relation(fields: [interviewerId], references: [id])
  candidateEmail         String
  candidateName          String?
  meetingLink            String        // Zoom/Meet/Teams URL
  scheduledAt            DateTime
  startedAt              DateTime?
  endedAt                DateTime?
  plannedDurationMinutes Int?          // e.g. 60
  status                 SessionStatus @default(PENDING)
  trustEvents            TrustEvent[]
  sessionInvitees        SessionInvitee[]
  events                 SessionEvent[]
  trustReport            Json?         // final report JSON
  overallScore           Int?          // 0-100
  createdAt              DateTime      @default(now())
}

enum SessionStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

model TrustEvent {
  id        String           @id @default(cuid())
  sessionId String
  session   InterviewSession @relation(fields: [sessionId], references: [id])
  type      String
  severity  String
  message   String
  data      Json?
  timestamp DateTime         @default(now())
}

model SessionEvent {
  id        String           @id @default(cuid())
  sessionId String
  session   InterviewSession @relation(fields: [sessionId], references: [id])
  timestamp DateTime
  type      String
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([sessionId, timestamp])
}

model SessionInvitee {
  id        String           @id @default(cuid())
  sessionId String
  session   InterviewSession @relation(fields: [sessionId], references: [id])
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  createdAt DateTime         @default(now())

  @@unique([sessionId, userId])
  @@index([userId])
}
